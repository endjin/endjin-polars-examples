{
  "properties": {
    "activities": [
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "year_range",
          "value": {
            "value": "@range(pipeline().parameters.start_year, add(sub(pipeline().parameters.end_year, pipeline().parameters.start_year), 1))",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set Range of Years To Load",
        "dependsOn": []
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "items": {
            "value": "@variables('year_range')",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Copy",
              "typeProperties": {
                "source": {
                  "type": "BinarySource",
                  "formatSettings": {
                    "type": "BinaryReadSettings"
                  },
                  "storeSettings": {
                    "type": "HttpReadSettings",
                    "requestMethod": "GET"
                  },
                  "datasetSettings": {
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "HttpServerLocation",
                        "relativeUrl": {
                          "value": "@concat('pp-', item(), '.csv')",
                          "type": "Expression"
                        }
                      }
                    },
                    "externalReferences": {
                      "connection": "daddcb54-f41f-4663-9bd0-cabd0d307a71"
                    },
                    "annotations": []
                  }
                },
                "sink": {
                  "type": "BinarySink",
                  "storeSettings": {
                    "type": "AzureBlobStorageWriteSettings"
                  },
                  "datasetSettings": {
                    "type": "Binary",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "folderPath": "land_registry_data",
                        "fileName": {
                          "value": "@concat('pp-', item(), '.csv')",
                          "type": "Expression"
                        }
                      }
                    },
                    "linkedService": {
                      "name": "HousePriceAnalytics",
                      "properties": {
                        "type": "Lakehouse",
                        "typeProperties": {
                          "artifactId": "9bc27141-91e3-8a9d-4be7-d11606134a22",
                          "workspaceId": "00000000-0000-0000-0000-000000000000",
                          "rootFolder": "Files"
                        },
                        "annotations": []
                      }
                    },
                    "annotations": []
                  }
                },
                "enableStaging": false
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Copy File From Land Registry",
              "dependsOn": []
            }
          ]
        },
        "name": "For Each Year",
        "dependsOn": [
          {
            "activity": "Set Range of Years To Load",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "start_year": {
        "type": "int",
        "defaultValue": 2015
      },
      "end_year": {
        "type": "int",
        "defaultValue": 2025
      }
    },
    "variables": {
      "year_range": {
        "type": "Array"
      }
    }
  }
}